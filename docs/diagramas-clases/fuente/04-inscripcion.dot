    "Documento" [label=<<TABLE BORDER="2" COLOR="#37474F" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0" BGCOLOR="#ECEFF1" STYLE="DASHED"><TR><TD BGCOLOR="#37474F" ALIGN="CENTER"><FONT COLOR="white" POINT-SIZE="1"> </FONT></TD></TR><TR><TD ALIGN="CENTER" CELLPADDING="5"><FONT POINT-SIZE="10" COLOR="#4B5563">&#171;Entidad (nueva)&#187;</FONT><BR/><B>Documento</B></TD></TR><TR><TD ALIGN="LEFT" BORDER="0" CELLPADDING="3"><TABLE BORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="1"><FONT POINT-SIZE="10">-tipo String</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="1"><FONT POINT-SIZE="10">-rutaStorage String</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="1"><FONT POINT-SIZE="10">-estado EstadoDocumento</FONT></TD></TR></TABLE></TD></TR></TABLE>>];
    "Categoria" -> "Documento" [style=invis, weight=50];
    "ConexionPool" [label=<<TABLE BORDER="2" COLOR="#00695C" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0" BGCOLOR="#E0F2F1"><TR><TD BGCOLOR="#00695C" ALIGN="CENTER"><FONT COLOR="white" POINT-SIZE="1"> </FONT></TD></TR><TR><TD ALIGN="CENTER" CELLPADDING="5"><FONT POINT-SIZE="10" COLOR="#4B5563">&#171;Fuente de datos&#187;</FONT><BR/><B>ConexionPool</B></TD></TR><TR><TD ALIGN="LEFT" BORDER="0" CELLPADDING="3"><TABLE BORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="1"><FONT POINT-SIZE="10">+getConnection() Connection</FONT></TD></TR></TABLE></TD></TR></TABLE>>];
    "Documento" -> "ConexionPool" [style=invis, weight=50];
  }
