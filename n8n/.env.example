# Copia este archivo como n8n/.env y completa los valores. n8n/.env NUNCA se sube al repositorio.

# Llave con la que n8n cifra las credenciales guardadas (SMTP, Header Auth).
# Genérala una vez con:  openssl rand -hex 32
# (PowerShell: -join ((1..32) | % { '{0:x2}' -f (Get-Random -Max 256) }))
# Si la cambias o la pierdes, las credenciales ya creadas dejan de funcionar.
N8N_ENCRYPTION_KEY=

# URL base de n8n, sin barra final. El backend llama a {N8N_BASE_URL}/webhook/futdata/notificaciones
N8N_BASE_URL=http://localhost:5678

# Secreto compartido entre el backend (N8nClient) y n8n. Va en la cabecera X-FutData-Token.
# Debe ser el mismo valor que se configura en la credencial "FutData Webhook Token" de n8n
# y en la variable N8N_WEBHOOK_TOKEN del backend. Genéralo igual que la llave de cifrado.
N8N_WEBHOOK_TOKEN=

# Remitente de los correos. Con Gmail debe ser la misma cuenta de la credencial "SMTP FutData".
SMTP_FROM="FutData <tu-cuenta@gmail.com>"

# Solo para los scripts de prueba (n8n/scripts/probar-2fa.*): a quién llega el correo de ejemplo.
CORREO_PRUEBA=tu-cuenta@gmail.com
