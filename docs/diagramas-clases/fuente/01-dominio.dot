digraph G {
  rankdir=TB; splines=true; overlap=false; compound=true; newrank=true;
  nodesep=0.6; ranksep=1.0; pad=0.35; bgcolor="white";
  labelloc=t; labeljust=l; fontname="Inter"; fontsize=20; fontcolor="#1A2332";
  label=<<B>Fig. 2 · Modelo de dominio (domain.entities)</B>>;
  node [shape=plain, fontname="Inter"]; edge [fontname="Inter", fontsize=10, color="#4B5563", fontcolor="#374151"];
  { rank=same;
    "L0" [shape=plaintext, label=<<FONT POINT-SIZE="11" COLOR="#6B7280"><B>SEGURIDAD<BR/>y acceso</B></FONT>>, fontname="Inter"];
    "Usuario" [label=<<TABLE BORDER="2" COLOR="#F9A825" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0" BGCOLOR="#FFF8E1"><TR><TD BGCOLOR="#F9A825" ALIGN="CENTER"><FONT COLOR="white" POINT-SIZE="1"> </FONT></TD></TR><TR><TD ALIGN="CENTER" CELLPADDING="5"><B>Usuario</B></TD></TR><TR><TD ALIGN="LEFT" BORDER="0" CELLPADDING="3"><TABLE BORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="1"><FONT POINT-SIZE="10">-id UUID</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="1"><FONT POINT-SIZE="10">-correo String</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="1"><FONT POINT-SIZE="10">-nombreCompleto String</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="1"><FONT POINT-SIZE="10">-activo boolean</FONT></TD></TR></TABLE></TD></TR></TABLE>>];
    "L0" -> "Usuario" [style=invis, weight=50];
    "Rol" [label=<<TABLE BORDER="2" COLOR="#F9A825" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0" BGCOLOR="#FFF8E1"><TR><TD BGCOLOR="#F9A825" ALIGN="CENTER"><FONT COLOR="white" POINT-SIZE="1"> </FONT></TD></TR><TR><TD ALIGN="CENTER" CELLPADDING="5"><B>Rol</B></TD></TR><TR><TD ALIGN="LEFT" BORDER="0" CELLPADDING="3"><TABLE BORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="1"><FONT POINT-SIZE="10">-id UUID</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="1"><FONT POINT-SIZE="10">-nombre NombreRol</FONT></TD></TR></TABLE></TD></TR></TABLE>>];
    "Usuario" -> "Rol" [style=invis, weight=50];
    "NombreRol" [label=<<TABLE BORDER="2" COLOR="#F9A825" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0" BGCOLOR="#FFF8E1"><TR><TD BGCOLOR="#F9A825" ALIGN="CENTER"><FONT COLOR="white" POINT-SIZE="1"> </FONT></TD></TR><TR><TD ALIGN="CENTER" CELLPADDING="5"><FONT POINT-SIZE="10" COLOR="#4B5563">&#171;enumeracion&#187;</FONT><BR/><B>NombreRol</B></TD></TR><TR><TD ALIGN="LEFT" BORDER="0" CELLPADDING="3"><TABLE BORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="1"><FONT POINT-SIZE="10">ADMINISTRADOR</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="1"><FONT POINT-SIZE="10">TESORERO</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="1"><FONT POINT-SIZE="10">ENTRENADOR</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="1"><FONT POINT-SIZE="10">ACUDIENTE</FONT></TD></TR></TABLE></TD></TR></TABLE>>];
    "Rol" -> "NombreRol" [style=invis, weight=50];
  }
  { rank=same;
    "L1" [shape=plaintext, label=<<FONT POINT-SIZE="11" COLOR="#6B7280"><B>RESPONSABLES<BR/>Y CUENTAS</B></FONT>>, fontname="Inter"];
    "CodigoVerificacion" [label=<<TABLE BORDER="2" COLOR="#F9A825" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0" BGCOLOR="#FFF8E1"><TR><TD BGCOLOR="#F9A825" ALIGN="CENTER"><FONT COLOR="white" POINT-SIZE="1"> </FONT></TD></TR><TR><TD ALIGN="CENTER" CELLPADDING="5"><B>CodigoVerificacion</B></TD></TR><TR><TD ALIGN="LEFT" BORDER="0" CELLPADDING="3"><TABLE BORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="1"><FONT POINT-SIZE="10">-codigoHash String</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="1"><FONT POINT-SIZE="10">-expiraEn Instant</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="1"><FONT POINT-SIZE="10">-intentos int</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="1"><FONT POINT-SIZE="10">-usado boolean</FONT></TD></TR></TABLE></TD></TR></TABLE>>];
    "L1" -> "CodigoVerificacion" [style=invis, weight=50];
    "EquipoConfianza" [label=<<TABLE BORDER="2" COLOR="#F9A825" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0" BGCOLOR="#FFF8E1"><TR><TD BGCOLOR="#F9A825" ALIGN="CENTER"><FONT COLOR="white" POINT-SIZE="1"> </FONT></TD></TR><TR><TD ALIGN="CENTER" CELLPADDING="5"><B>EquipoConfianza</B></TD></TR><TR><TD ALIGN="LEFT" BORDER="0" CELLPADDING="3"><TABLE BORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="1"><FONT POINT-SIZE="10">-identificadorHash String</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="1"><FONT POINT-SIZE="10">-vigenteHasta Instant</FONT></TD></TR></TABLE></TD></TR></TABLE>>];
    "CodigoVerificacion" -> "EquipoConfianza" [style=invis, weight=50];
    "Acudiente" [label=<<TABLE BORDER="2" COLOR="#37474F" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0" BGCOLOR="#ECEFF1"><TR><TD BGCOLOR="#37474F" ALIGN="CENTER"><FONT COLOR="white" POINT-SIZE="1"> </FONT></TD></TR><TR><TD ALIGN="CENTER" CELLPADDING="5"><B>Acudiente</B></TD></TR><TR><TD ALIGN="LEFT" BORDER="0" CELLPADDING="3"><TABLE BORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="1"><FONT POINT-SIZE="10">-id UUID</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="1"><FONT POINT-SIZE="10">-nombreCompleto String</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="1"><FONT POINT-SIZE="10">-documentoIdentidad String</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="1"><FONT POINT-SIZE="10">-telefono String</FONT></TD></TR></TABLE></TD></TR></TABLE>>];
    "EquipoConfianza" -> "Acudiente" [style=invis, weight=50];
    "Entrenador" [label=<<TABLE BORDER="2" COLOR="#37474F" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0" BGCOLOR="#ECEFF1"><TR><TD BGCOLOR="#37474F" ALIGN="CENTER"><FONT COLOR="white" POINT-SIZE="1"> </FONT></TD></TR><TR><TD ALIGN="CENTER" CELLPADDING="5"><B>Entrenador</B></TD></TR><TR><TD ALIGN="LEFT" BORDER="0" CELLPADDING="3"><TABLE BORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="1"><FONT POINT-SIZE="10">-id UUID</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="1"><FONT POINT-SIZE="10">-nombreCompleto String</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="1"><FONT POINT-SIZE="10">-telefono String</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="1"><FONT POINT-SIZE="10">-especialidad String</FONT></TD></TR></TABLE></TD></TR></TABLE>>];
    "Acudiente" -> "Entrenador" [style=invis, weight=50];
  }
  { rank=same;
    "L2" [shape=plaintext, label=<<FONT POINT-SIZE="11" COLOR="#6B7280"><B>DEPORTISTAS<BR/>Y ENTRENAMIENTOS</B></FONT>>, fontname="Inter"];
    "Deportista" [label=<<TABLE BORDER="2" COLOR="#37474F" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0" BGCOLOR="#ECEFF1"><TR><TD BGCOLOR="#37474F" ALIGN="CENTER"><FONT COLOR="white" POINT-SIZE="1"> </FONT></TD></TR><TR><TD ALIGN="CENTER" CELLPADDING="5"><B>Deportista</B></TD></TR><TR><TD ALIGN="LEFT" BORDER="0" CELLPADDING="3"><TABLE BORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="1"><FONT POINT-SIZE="10">-id UUID</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="1"><FONT POINT-SIZE="10">-nombreCompleto String</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="1"><FONT POINT-SIZE="10">-fechaNacimiento LocalDate</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="1"><FONT POINT-SIZE="10">-documentoIdentidad String</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="1"><FONT POINT-SIZE="10">-telefono String</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="1"><FONT POINT-SIZE="10">-direccion String</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="1"><FONT POINT-SIZE="10">-estado EstadoDeportista</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="1"><FONT POINT-SIZE="10">+edad() int</FONT></TD></TR></TABLE></TD></TR></TABLE>>];
    "L2" -> "Deportista" [style=invis, weight=50];
    "Categoria" [label=<<TABLE BORDER="2" COLOR="#37474F" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0" BGCOLOR="#ECEFF1"><TR><TD BGCOLOR="#37474F" ALIGN="CENTER"><FONT COLOR="white" POINT-SIZE="1"> </FONT></TD></TR><TR><TD ALIGN="CENTER" CELLPADDING="5"><B>Categoria</B></TD></TR><TR><TD ALIGN="LEFT" BORDER="0" CELLPADDING="3"><TABLE BORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="1"><FONT POINT-SIZE="10">-id UUID</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="1"><FONT POINT-SIZE="10">-nombre String</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="1"><FONT POINT-SIZE="10">-edadMinima int</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="1"><FONT POINT-SIZE="10">-edadMaxima int</FONT></TD></TR></TABLE></TD></TR></TABLE>>];
    "Deportista" -> "Categoria" [style=invis, weight=50];
    "Entrenamiento" [label=<<TABLE BORDER="2" COLOR="#C62828" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0" BGCOLOR="#FFFFFF" STYLE="DASHED"><TR><TD BGCOLOR="#C62828" ALIGN="CENTER"><FONT COLOR="white" POINT-SIZE="1"> </FONT></TD></TR><TR><TD ALIGN="CENTER" CELLPADDING="5"><FONT POINT-SIZE="10" COLOR="#4B5563">&#171;nueva&#187;</FONT><BR/><B>Entrenamiento</B></TD></TR><TR><TD ALIGN="LEFT" BORDER="0" CELLPADDING="3"><TABLE BORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="1"><FONT POINT-SIZE="10">-fecha LocalDate</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="1"><FONT POINT-SIZE="10">-horaInicio LocalTime</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="1"><FONT POINT-SIZE="10">-lugar String</FONT></TD></TR></TABLE></TD></TR></TABLE>>];
    "Categoria" -> "Entrenamiento" [style=invis, weight=50];
  }
  { rank=same;
    "L3" [shape=plaintext, label=<<FONT POINT-SIZE="11" COLOR="#6B7280"><B>ACTIVIDAD<BR/>y SEGUIMIENTO</B></FONT>>, fontname="Inter"];
    "Asistencia" [label=<<TABLE BORDER="2" COLOR="#37474F" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0" BGCOLOR="#ECEFF1"><TR><TD BGCOLOR="#37474F" ALIGN="CENTER"><FONT COLOR="white" POINT-SIZE="1"> </FONT></TD></TR><TR><TD ALIGN="CENTER" CELLPADDING="5"><B>Asistencia</B></TD></TR><TR><TD ALIGN="LEFT" BORDER="0" CELLPADDING="3"><TABLE BORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="1"><FONT POINT-SIZE="10">-estado EstadoAsistencia</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="1"><FONT POINT-SIZE="10">-observaciones String</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="1"><FONT POINT-SIZE="10">-registradaEn Instant</FONT></TD></TR></TABLE></TD></TR></TABLE>>];
    "L3" -> "Asistencia" [style=invis, weight=50];
    "Pago" [label=<<TABLE BORDER="2" COLOR="#37474F" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0" BGCOLOR="#ECEFF1"><TR><TD BGCOLOR="#37474F" ALIGN="CENTER"><FONT COLOR="white" POINT-SIZE="1"> </FONT></TD></TR><TR><TD ALIGN="CENTER" CELLPADDING="5"><B>Pago</B></TD></TR><TR><TD ALIGN="LEFT" BORDER="0" CELLPADDING="3"><TABLE BORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="1"><FONT POINT-SIZE="10">-periodo YearMonth</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="1"><FONT POINT-SIZE="10">-valor BigDecimal</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="1"><FONT POINT-SIZE="10">-estado EstadoPago</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="1"><FONT POINT-SIZE="10">-metodo String</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="1"><FONT POINT-SIZE="10">-referencia String</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="1"><FONT POINT-SIZE="10">-fechaPago Instant</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="1"><FONT POINT-SIZE="10">-comprobanteRuta String</FONT></TD></TR></TABLE></TD></TR></TABLE>>];
    "Asistencia" -> "Pago" [style=invis, weight=50];
    "Torneo" [label=<<TABLE BORDER="2" COLOR="#37474F" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0" BGCOLOR="#ECEFF1"><TR><TD BGCOLOR="#37474F" ALIGN="CENTER"><FONT COLOR="white" POINT-SIZE="1"> </FONT></TD></TR><TR><TD ALIGN="CENTER" CELLPADDING="5"><B>Torneo</B></TD></TR><TR><TD ALIGN="LEFT" BORDER="0" CELLPADDING="3"><TABLE BORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="1"><FONT POINT-SIZE="10">-nombre String</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="1"><FONT POINT-SIZE="10">-fechaInicio LocalDate</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="1"><FONT POINT-SIZE="10">-fechaFin LocalDate</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="1"><FONT POINT-SIZE="10">-costoInscripcion BigDecimal</FONT></TD></TR></TABLE></TD></TR></TABLE>>];
    "Pago" -> "Torneo" [style=invis, weight=50];
    "Documento" [label=<<TABLE BORDER="2" COLOR="#C62828" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0" BGCOLOR="#FFFFFF" STYLE="DASHED"><TR><TD BGCOLOR="#C62828" ALIGN="CENTER"><FONT COLOR="white" POINT-SIZE="1"> </FONT></TD></TR><TR><TD ALIGN="CENTER" CELLPADDING="5"><FONT POINT-SIZE="10" COLOR="#4B5563">&#171;nueva&#187;</FONT><BR/><B>Documento</B></TD></TR><TR><TD ALIGN="LEFT" BORDER="0" CELLPADDING="3"><TABLE BORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="1"><FONT POINT-SIZE="10">-tipo String</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="1"><FONT POINT-SIZE="10">-rutaStorage String</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="1"><FONT POINT-SIZE="10">-estado EstadoDocumento</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="1"><FONT POINT-SIZE="10">-venceEn LocalDate</FONT></TD></TR></TABLE></TD></TR></TABLE>>];
    "Torneo" -> "Documento" [style=invis, weight=50];
  }
  "L0" -> "L1" [style=invis, weight=100];
  "L1" -> "L2" [style=invis, weight=100];
  "L2" -> "L3" [style=invis, weight=100];
  "LEG" [shape=plain, label=<<TABLE BORDER="1" COLOR="#9CA3AF" CELLBORDER="0" CELLSPACING="2" CELLPADDING="3" BGCOLOR="white"><TR><TD COLSPAN="2" ALIGN="LEFT"><B><FONT POINT-SIZE="10">Leyenda</FONT></B></TD></TR><TR><TD BGCOLOR="#FFF8E1" BORDER="1" COLOR="#F9A825" WIDTH="18" HEIGHT="14"> </TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10">Seguridad y acceso</FONT></TD></TR><TR><TD BGCOLOR="#ECEFF1" BORDER="1" COLOR="#37474F" WIDTH="18" HEIGHT="14"> </TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10">Entidad (domain.entities)</FONT></TD></TR><TR><TD BGCOLOR="#FFFFFF" BORDER="1" COLOR="#C62828" WIDTH="18" HEIGHT="14"> </TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10">Entidad nueva (no esta en el PPI 4.2)</FONT></TD></TR><TR><TD ALIGN="LEFT" COLSPAN="2"><FONT POINT-SIZE="10">- - -&#9655; implementa &#160;&#160; - - -&gt; depende de (usa) &#160;&#160; &#9671;&#8212; agregacion &#160;&#160; &#9670;&#8212; composicion</FONT></TD></TR></TABLE>>];
  "Documento" -> "LEG" [style=invis, weight=1];
  "Usuario" -> "Rol" [taillabel="*", headlabel="1", arrowhead=vee, arrowsize=0.8, constraint=false, labeldistance=1.6];
  "Usuario" -> "CodigoVerificacion" [taillabel="1", headlabel="*", dir=both, arrowtail=diamond, arrowhead=none, arrowsize=1.1, constraint=false, labeldistance=1.6];
  "Usuario" -> "EquipoConfianza" [taillabel="1", headlabel="*", dir=both, arrowtail=diamond, arrowhead=none, arrowsize=1.1, constraint=false, labeldistance=1.6];
  "Usuario" -> "Acudiente" [label="cuenta de", taillabel="1", headlabel="0..1", arrowhead=none, constraint=false, labeldistance=1.6];
  "Usuario" -> "Entrenador" [label="cuenta de", taillabel="1", headlabel="0..1", arrowhead=none, constraint=false, labeldistance=1.6];
  "Acudiente" -> "Deportista" [label="responsable de", taillabel="1", headlabel="1..*", arrowhead=none, constraint=false, labeldistance=1.6];
  "Deportista" -> "Categoria" [label="pertenece a", taillabel="*", headlabel="1", arrowhead=vee, arrowsize=0.8, constraint=false, labeldistance=1.6];
  "Entrenador" -> "Categoria" [label="dirige", taillabel="1", headlabel="*", arrowhead=none, constraint=false, labeldistance=1.6];
  "Categoria" -> "Entrenamiento" [label="programa", taillabel="1", headlabel="*", arrowhead=none, constraint=false, labeldistance=1.6];
  "Entrenador" -> "Entrenamiento" [label="a cargo de", taillabel="1", headlabel="*", arrowhead=none, constraint=false, labeldistance=1.6];
  "Entrenamiento" -> "Asistencia" [taillabel="1", headlabel="*", dir=both, arrowtail=diamond, arrowhead=none, arrowsize=1.1, constraint=false, labeldistance=1.6];
  "Deportista" -> "Asistencia" [taillabel="1", headlabel="*", arrowhead=none, constraint=false, labeldistance=1.6];
  "Deportista" -> "Pago" [taillabel="1", headlabel="*", dir=both, arrowtail=diamond, arrowhead=none, arrowsize=1.1, constraint=false, labeldistance=1.6];
  "Deportista" -> "Torneo" [label="participa", taillabel="*", headlabel="*", arrowhead=none, constraint=false, labeldistance=1.6];
  "Deportista" -> "Documento" [taillabel="1", headlabel="*", dir=both, arrowtail=diamond, arrowhead=none, arrowsize=1.1, constraint=false, labeldistance=1.6];
  "Rol" -> "NombreRol" [style=dashed, arrowhead=vee, arrowsize=0.8, constraint=false];
}