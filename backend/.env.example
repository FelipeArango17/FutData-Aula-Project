# Copia este archivo como backend/.env y completa los valores. backend/.env NUNCA se sube al repositorio.
# Formato: CLAVE=valor, una por línea, SIN comillas (Spring lo lee como un archivo .properties).
# Con el perfil local todas son opcionales: sin ellas la aplicación arranca y /api/health responde 503.

# --- Base de datos: PostgreSQL de Supabase por JDBC con SSL ---
# Supabase > Project Settings > Database > Connection string > JDBC, modo "Session pooler" (puerto 5432).
# Mantén sslmode=require. Con el "Transaction pooler" (puerto 6543) agrega también &prepareThreshold=0.
DB_URL=jdbc:postgresql://aws-0-us-east-1.pooler.supabase.com:5432/postgres?sslmode=require
DB_USER=postgres.tu-ref-de-proyecto
DB_PASSWORD=

# --- CORS: orígenes del frontend permitidos, separados por coma ---
CORS_ORIGINS=http://localhost:5173

# --- Frontend: dirección pública, sin barra final ---
# Con ella se arma el enlace del correo para crear la contraseña ({FRONTEND_URL}/crear-contrasena?token=...).
# En local, por defecto http://localhost:5173; si falta, el alta de un entrenador funciona pero el correo no se
# envía (correoEnviado=false). En prod (Render, con la URL de Vercel) es obligatoria: sin ella la app no arranca.
FRONTEND_URL=http://localhost:5173

# --- n8n: notificaciones por correo (INotificador / N8nClient, tarea 340) ---
# Mismos valores que N8N_BASE_URL y N8N_WEBHOOK_TOKEN de n8n/.env. URL sin barra final; token aleatorio
# (openssl rand -hex 32). En local pueden quedar vacías: la app arranca, pero enviar una notificación
# falla con NotificadorMalConfiguradoException. En prod son obligatorias.
N8N_BASE_URL=http://localhost:5678
N8N_WEBHOOK_TOKEN=
# Opcional: tiempo de espera solo para ENLACE_CONTRASENA, que es síncrono (por defecto 15s; los demás eventos, 5 s).
# N8N_TIMEOUT_ENLACE=15s

# --- Datos del club en los comprobantes PDF (opcionales: ya tienen valor por defecto en application.yml) ---
# Si una queda vacía (CLAVE=), esa línea no se imprime. Este archivo se lee en ISO-8859-1: escribe las
# tildes como \u00e1 \u00e9 \u00ed \u00f3 \u00fa \u00f1 o define la variable en el sistema.
# CLUB_NOMBRE=Asociaci\u00f3n Deportiva Prado F\u00fatbol Club
# CLUB_NIT=811032309-1
# CLUB_DIRECCION=Calle 40 Sur 75b-81, San Antonio de Prado, Medell\u00edn, Antioquia
# CLUB_TELEFONO=3137317366
# CLUB_CORREO=pradofutbolclub@gmail.com

# --- Supabase: Storage (comprobantes, tarea 328) y Auth (HU-001) ---
# URL del proyecto, sin barra final: Supabase > Project Settings > API > Project URL. La usan Storage y la validación
# de los JWT de Auth (las llaves públicas salen de {SUPABASE_URL}/auth/v1/.well-known/jwks.json).
SUPABASE_URL=https://tu-ref-de-proyecto.supabase.co
# SECRETA. Llave service_role (Project Settings > API Keys > service_role / secret). Salta todas las políticas de acceso
# (RLS): SOLO para el backend. Nunca en el frontend, en Vercel, en n8n, en el repositorio ni en un mensaje.
# En local puede quedar vacía: la app arranca, pero guardar o descargar comprobantes falla con
# AlmacenamientoNoConfiguradoException. En prod es obligatoria.
SUPABASE_SERVICE_ROLE_KEY=
# Opcionales: bucket privado de los comprobantes y vigencia de las URL firmadas de descarga (por defecto 5m).
# SUPABASE_BUCKET_COMPROBANTES=comprobantes
# SUPABASE_VIGENCIA_URL_FIRMADA=5m
# Opcionales: bucket privado de las fotos de los deportistas (migración 007) y vigencia de su URL firmada, de 10s
# a 60m (por defecto 60m; es aparte de la de los comprobantes).
# FOTOS_BUCKET=fotos
# FOTOS_VIGENCIA_URL_FIRMADA=60m
# Opcionales: bucket privado de los documentos de la inscripción (migración 007) y vigencia de su URL firmada de
# descarga, de 10s a 60m (por defecto 300s: son documentos de menores).
# DOCUMENTOS_BUCKET=documentos
# DOCUMENTOS_VIGENCIA_URL_FIRMADA=300s

# --- Pagos en línea con Wompi (sandbox por defecto; ver "Pagos con Wompi" en backend/README.md) ---
# SECRETAS (salvo la pública): nunca en el repositorio, en el frontend, en un log ni en un mensaje. Sin ellas la app arranca y los
# endpoints de Wompi responden 503 PAGOS_NO_CONFIGURADOS. Sandbox: llaves pub_test_, prv_test_, test_events_, test_integrity_ y
# URL https://sandbox.wompi.co/v1. Producción: llaves _prod_ y https://production.wompi.co/v1. Nunca se mezclan.
WOMPI_PUBLIC_KEY=
WOMPI_PRIVATE_KEY=
WOMPI_EVENTS_SECRET=
WOMPI_INTEGRITY_SECRET=
# WOMPI_BASE_URL=https://sandbox.wompi.co/v1
# A dónde vuelve el usuario tras pagar en el checkout (solo informa: el pago se confirma por el webhook)
# WOMPI_REDIRECT_URL=http://localhost:5173/acudiente/pagos

# --- Cobro mensual ---
# PENDIENTE: el club define el monto real (pesos enteros). 0 = sin configurar: no se generan mensualidades.
# FUTDATA_MENSUALIDAD_MONTO=0
# FUTDATA_MENSUALIDAD_DIA_VENCIMIENTO=5
# true = cada día a las 6:00 (Colombia) crea la mensualidad PENDIENTE del mes en curso de cada deportista
# FUTDATA_MENSUALIDAD_GENERACION_AUTOMATICA=false

# --- Opcionales ---
# Puerto HTTP (por defecto 8080) y tamaño máximo del pool de conexiones (por defecto 5).
# PORT=8080
# DB_POOL_MAX=5
